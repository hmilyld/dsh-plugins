{
  "name": "@hmilyld/dsh-ocgo-usage-dock",
  "version": "0.4.0",
  "description": "DSH (DeepSeek Harness) web dock showing OpenCode Go rolling, weekly, and monthly usage, with a credential-backed settings page.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "cordis.patch.yml",
    "lib/index.js",
    "lib/client.js",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node ../../tooling/build/build-package.mjs .",
    "typecheck": "tsc -b tsconfig.json tsconfig.client.json",
    "test": "pnpm run build && pnpm -w exec vitest run packages/dsh-ocgo-usage-dock",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "opencode",
    "usage"
  ],
  "license": "MIT",
  "author": "hmilyld",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hmilyld/dsh-plugins.git",
    "directory": "packages/dsh-ocgo-usage-dock"
  },
  "homepage": "https://github.com/hmilyld/dsh-plugins/tree/main/packages/dsh-ocgo-usage-dock#readme",
  "bugs": {
    "url": "https://github.com/hmilyld/dsh-plugins/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-api-remotes": "catalog:",
    "@deepseek-ai/dsh-client-locale": "catalog:",
    "@deepseek-ai/dsh-client-store": "catalog:",
    "@deepseek-ai/dsh-client-ui-conversation": "catalog:",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "catalog:",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@deepseek-ai/dsh-credentials": "catalog:",
    "@deepseek-ai/dsh-typert-protocol": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "@hmilyld/dsh-plugin-kit": "workspace:*",
    "vitest": "catalog:"
  }
}
