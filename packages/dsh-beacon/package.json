{
  "name": "@hmilyld/dsh-beacon",
  "version": "0.2.2",
  "description": "DSH (DeepSeek Harness) webhook beacon: POST a JSON payload with variable substitution when a task completes or the agent needs user questions, plan confirmation, or approval.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json && tsc -b tsconfig.client.json && node ../../tooling/build/build-client.mjs .",
    "typecheck": "tsc -b tsconfig.json tsconfig.client.json",
    "test": "pnpm run build && node scripts/smoke-test.mjs",
    "send-test": "pnpm run build && node scripts/send-test.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm run test",
    "prepare": "pnpm run build"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "webhook",
    "notification"
  ],
  "license": "MIT",
  "author": "hmilyld",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hmilyld/dsh-plugins.git",
    "directory": "packages/dsh-beacon"
  },
  "homepage": "https://github.com/hmilyld/dsh-plugins/tree/main/packages/dsh-beacon#readme",
  "bugs": {
    "url": "https://github.com/hmilyld/dsh-plugins/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-user-questions": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.2.0-rc.2",
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "^1.8.5",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "catalog:",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-tool-ask-user": "catalog:",
    "@deepseek-ai/dsh-user-approval": "catalog:",
    "@deepseek-ai/dsh-user-questions": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  }
}
