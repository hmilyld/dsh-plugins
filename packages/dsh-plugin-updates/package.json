{
  "name": "@hmilyld/dsh-plugin-updates",
  "version": "0.1.0",
  "description": "Update detection for @hmilyld DSH plugins: npm registry lookup, pre-release-aware version comparison, and a settings notice.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "pnpm run build && node test/smoke.mjs",
    "prepublishOnly": "pnpm run test",
    "prepare": "pnpm run build"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "update"
  ],
  "license": "MIT",
  "author": "hmilyld",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hmilyld/dsh-plugins.git",
    "directory": "packages/dsh-plugin-updates"
  },
  "homepage": "https://github.com/hmilyld/dsh-plugins/tree/main/packages/dsh-plugin-updates#readme",
  "bugs": {
    "url": "https://github.com/hmilyld/dsh-plugins/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  }
}
