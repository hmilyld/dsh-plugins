{
  "name": "@hmilyld/dsh-plugins",
  "private": true,
  "type": "module",
  "description": "Monorepo for hmilyld's DeepSeek Harness (DSH) plugins",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "tsc -b tsconfig.host.json tsconfig.client.json",
    "test": "pnpm -r --filter \"./packages/*\" run test",
    "check": "pnpm run build && pnpm run lint && pnpm run test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "pack:check": "pnpm --filter @hmilyld/dsh-beacon --filter @hmilyld/dsh-ocgo-usage-dock exec publint",
    "gen:plugin": "node tooling/scaffold/index.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@deepseek-ai/dsh-typert-generator": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "publint": "catalog:"
  }
}
