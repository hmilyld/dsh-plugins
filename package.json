{
  "name": "@hmilyld/dsh-plugins",
  "private": true,
  "type": "module",
  "description": "Monorepo for hmilyld's DeepSeek Harness (DSH) plugins",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "tsc -b tsconfig.host.json tsconfig.client.json",
    "test": "pnpm -r --filter \"./packages/*\" run test",
    "check": "pnpm run build && pnpm run test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@deepseek-ai/dsh-typert-generator": "0.2.0-rc.2",
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "typescript": "6.0.3"
  }
}
